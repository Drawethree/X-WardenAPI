<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.drawethree.xwarden</groupId>
    <artifactId>X-WardenAPI</artifactId>
    <version>1.1.0</version>
    <packaging>jar</packaging>

    <name>X-WardenAPI</name>
    <description>Official API for the X-Warden plugin</description>
    <url>https://builtbybit.com/resources/x-warden-anti-cheat-anti-exploit.125374/</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>drawethree</id>
            <name>Jan Kluka</name>
            <url>https://drawethree.dev</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/Drawethree/X-WardenAPI.git</connection>
        <developerConnection>scm:git:git@github.com:Drawethree/X-WardenAPI.git</developerConnection>
        <url>https://github.com/Drawethree/X-WardenAPI</url>
    </scm>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>spigot-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- spigot-api, not paper-api, and that is the whole point. X-Warden builds against Paper
             and is sold to servers running Spigot; a Paper-only method compiles and links like any
             other and fails only on the server that lacks it. An API compiled against Spigot cannot
             contain one - it is a compile error here rather than a NoSuchMethodError there.
             'provided' scope is not transitive, so X-Warden's own build still sees only paper-api
             and the two artifacts never share a classpath. -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.21.8-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- Evidence is stored as JSON. Gson comes from the server, exactly as it does for
             X-PrisonAPI, and is never shaded. -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- @NotNull on the event getters; supplied by the server at runtime, as it is for
             every other plugin. -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>24.1.0</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.13.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Where the artifacts end up. Nothing writes here directly - the hosting is plain FTP with
         no HTTP PUT endpoint, so the release workflow deploys into a local staging tree with
         -DaltDeploymentRepository and mirrors that up. These URLs are the read side, recorded here
         so the published pom says where it came from. -->
    <distributionManagement>
        <repository>
            <id>drawethree-releases</id>
            <name>drawethree.dev releases</name>
            <url>https://repo.drawethree.dev/releases</url>
        </repository>
        <snapshotRepository>
            <id>drawethree-snapshots</id>
            <name>drawethree.dev snapshots</name>
            <url>https://repo.drawethree.dev/snapshots</url>
        </snapshotRepository>
    </distributionManagement>

    <build>
        <defaultGoal>clean install</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- An API jar is read in an IDE more often than it is run. Sources and javadoc are
                 what make ctrl-click land on the contract and its comments instead of a decompiler.
                 doclint is on and warnings fail the build: a public method with no documentation,
                 or a broken tag, is a defect in an artifact whose whole point is to be read. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <configuration>
                    <doclint>all</doclint>
                    <failOnWarnings>true</failOnWarnings>
                    <quiet>true</quiet>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Pinned because the workflow passes id::url to altDeploymentRepository, which is
                 the 3.x form; 2.x wants a layout segment in the middle. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.1.4</version>
            </plugin>
        </plugins>
    </build>
</project>
