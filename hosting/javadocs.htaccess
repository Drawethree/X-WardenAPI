# Served at javadocs.drawethree.dev.

Options +Indexes -MultiViews
DirectoryIndex index.html

AddType text/html .html
AddType text/css .css
AddType application/javascript .js

<IfModule mod_headers.c>
    # A published version directory never changes again, so its assets cache hard. The
    # redirect page at each project root is rewritten on every release, so it must not.
    <FilesMatch "\.(css|js|png|svg|gif|zip)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=300"
    </FilesMatch>
</IfModule>
